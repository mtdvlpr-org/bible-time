    "@nuxtjs/supabase": "^2.0.10",
    "@pinia/nuxt": "^0.11.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/nuxt": "^14.4.0",
    "@vueuse/router": "^14.4.0",
    "node-html-parser": "^7.1.0",
    "nuxt": "^4.4.4",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue-timeline-chart": "^4.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@netlify/nuxt": "^0.3.9",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^3.23.0",
    "@pinia/testing": "^1.0.3",
    "@types/node": "^22.20.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.104.0",
    "supabase": "^2.116.0",
    "typescript": "^5.9.3",
    "vite-plugin-markdown": "^2.2.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11"
